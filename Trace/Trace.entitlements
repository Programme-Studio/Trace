<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets Trace ask Safari to open a link in a tab instead of a new window.
	     Required by the hardened runtime before any Apple Event is sent; the
	     user still has to grant Automation permission for Safari itself. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
